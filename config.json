# Pac-Man configuration (JSON with comments).
# Lines starting with '#' are ignored; '//' and '/* */' work too.
# Missing or invalid values fall back to safe defaults (see README).
{
    // Where the top-10 scores are stored
    "highscore_filename": "highscores.json",

    // Assigned A-Maze-ing package: module and class names to import
    "maze_module": "mazegen",
    "maze_class": "MazeGenerator",

    "lives": 3,
    "pacgum": 42,                  // number of pacgums per level
    "points_per_pacgum": 10,
    "points_per_super_pacgum": 50,
    "points_per_ghost": 200,
    "seed": 42,                    // seed of level 1 (0 = random)
    "level_max_time": 90,          // seconds per level

    // Extra tuning keys
    "power_duration": 8,           // seconds ghosts stay edible
    "ghost_respawn_time": 5,       // seconds before an eaten ghost returns
    "player_speed": 7,             // cells per second
    "ghost_speed": 5.5,            // cells per second
    "cheat_mode": false,           // start with the cheat mode enabled

    // At least 10 levels (missing ones are added with default sizes)
    "levels": [
        {"width": 15, "height": 15},
        {"width": 16, "height": 16},
        {"width": 17, "height": 17},
        {"width": 18, "height": 18},
        {"width": 19, "height": 19},
        {"width": 20, "height": 20},
        {"width": 21, "height": 21},
        {"width": 22, "height": 22},
        {"width": 23, "height": 23},
        {"width": 24, "height": 24}
    ]
}
